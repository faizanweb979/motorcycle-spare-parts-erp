# Environment variables example for Motorcycle Spare Parts ERP

# Gemini API Key for server-side AI Chat and Advisory features
GEMINI_API_KEY=

# Groq API Key for secondary/primary AI Consultation Chat
GROQ_API_KEY=

# Firebase Admin SDK credentials for setting custom claims
# Download service account key from Firebase Console > Project Settings > Service Accounts
# Or set these environment variables individually
FIREBASE_PROJECT_ID=gen-lang-client-0201542724
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin email to grant custom claims
ADMIN_EMAIL=muslimbrothersadmin@gmail.com
