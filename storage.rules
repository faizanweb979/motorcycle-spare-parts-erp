rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// FIREBASE STORAGE SECURITY RULES - MOTORCYCLE SPARE PARTS ERP
// ════════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {
    
    // AUTHENTICATION HELPERS
    function isSignedIn() {
      return request.auth != null;
    }

    // FILE VALIDATION HELPERS
    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidImageSize() {
      // Limit images to 10MB (10 * 1024 * 1024 bytes)
      return request.resource.size < 10 * 1024 * 1024;
    }

    // ════════════════════════════════════════════════════════════════════════
    // PART IMAGES STORAGE RULES
    // ════════════════════════════════════════════════════════════════════════
    
    // Parts images: /parts/{partId}/{imageFile}
    match /parts/{partId}/{imageFile} {
      // READ: Public / Authenticated reading of parts catalog images
      allow read: if true;
      
      // WRITE / CREATE: Any authenticated user can upload valid image files
      allow write, create, update: if isSignedIn() && isValidImageType() && isValidImageSize();
      
      // DELETE: Authenticated users can delete images
      allow delete: if isSignedIn();
    }

    // Deny all other paths - no catch-all rule for security
    match /{allPaths=**} {
      allow read, write, create, update, delete: if false;
    }
  }
}