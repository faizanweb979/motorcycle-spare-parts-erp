rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ════════════════════════════════════════════════════════════════════════
    // AUTHENTICATION & AUTHORIZATION HELPERS
    // ════════════════════════════════════════════════════════════════════════
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // ROLE-BASED ACCESS CONTROL
    // Uses Firebase Auth Custom Claims for production-grade security
    // Custom claims are set server-side via Firebase Admin SDK
    function getUserRole() {
      // Read the custom claim 'role' from the auth token
      return request.auth.token.role;
    }

    function isSuperAdmin() {
      // Super admin can operate without email verification (trusted user for database reset)
      return isSignedIn() && getUserRole() == 'super_admin';
    }

    function isAdmin() {
      // Super admin can perform admin operations without email verification
      return isSuperAdmin() || (isEmailVerified() && (getUserRole() == 'admin' || getUserRole() == 'super_admin'));
    }

    function isOperator() {
      // Super admin can read/list without email verification
      return isSuperAdmin() || (isEmailVerified() && (getUserRole() == 'operator' || getUserRole() == 'admin' || getUserRole() == 'super_admin'));
    }

    // VALIDATION HELPERS
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isValidNumber(value, minValue) {
      return value is number && value >= minValue;
    }

    function isValidOptionalString(value, maxLength) {
      return !('value' in resource.data) || (value is string && value.size() <= maxLength);
    }

    // ════════════════════════════════════════════════════════════════════════
    // DATA VALIDATION FUNCTIONS (ENHANCED WITH NEW FIELDS)
    // ════════════════════════════════════════════════════════════════════════

    function isValidPart(data) {
      return data.partNumber is string && data.partNumber.size() <= 100 &&
             data.name is string && data.name.size() <= 200 &&
             data.brand is string && data.brand.size() <= 100 &&
             data.purchasePrice is number && data.purchasePrice >= 0 &&
             data.retailPrice is number && data.retailPrice >= 0 &&
             data.stock is number &&
             data.minStock is number && data.minStock >= 0 &&
             // Enhanced validation for NEW FIELDS - TEMPORARY: less strict validation
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2048)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('modelCompatibility' in data) || (data.modelCompatibility is string && data.modelCompatibility.size() <= 200)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100));
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.balance is number &&
             (!("advance" in data) || data.advance is number);
    }

    function isValidSupplier(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.balance is number &&
             (!("advance" in data) || data.advance is number);
    }

    function isValidSale(data) {
      return data.invoiceNumber is string && data.invoiceNumber.size() <= 100 &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.paidAmount is number && data.paidAmount >= 0 &&
             data.balanceAmount is number &&
             data.status is string && data.status.size() <= 50 &&
             data.items is list;
    }

    function isValidPurchase(data) {
      return data.invoiceNumber is string && data.invoiceNumber.size() <= 100 &&
             data.supplierId is string && data.supplierId.size() <= 128 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.paidAmount is number && data.paidAmount >= 0 &&
             data.balanceAmount is number &&
             data.status is string && data.status.size() <= 50 &&
             data.items is list;
    }

    function isValidAdjustment(data) {
      return data.partId is string && data.partId.size() <= 128 &&
             data.type is string && data.type.size() <= 50 &&
             data.quantity is number;
    }

    // AUDIT LOG VALIDATION - IMMUTABLE AFTER CREATION
    function isValidAuditLog(data) {
      return data.userEmail is string && data.userEmail.size() <= 150 &&
             data.action is string && data.action.size() <= 100 &&
             data.details is string && data.details.size() <= 1000 &&
             data.createdAt is string;
    }

    function isValidPayment(data) {
      return data.voucherNumber is string && data.voucherNumber.size() <= 100 &&
             data.date is string &&
             data.entityType is string && (data.entityType == "customer" || data.entityType == "supplier") &&
             data.entityId is string && data.entityId.size() <= 128 &&
             data.entityName is string && data.entityName.size() <= 200 &&
             data.amount is number && data.amount >= 0 &&
             data.paymentMethod is string && data.paymentMethod.size() <= 50 &&
             data.recordedBy is string && data.recordedBy.size() <= 150 &&
             data.createdAt is string &&
             (!("referenceNumber" in data) || (data.referenceNumber is string && data.referenceNumber.size() <= 100)) &&
             (!("remarks" in data) || (data.remarks is string && data.remarks.size() <= 1000));
    }

    function isValidLedgerEntry(data) {
      return data.entityId is string && data.entityId.size() <= 128 &&
             data.entityType is string && (data.entityType == "customer" || data.entityType == "supplier") &&
             data.date is string &&
             data.transactionType is string && data.transactionType.size() <= 50 &&
             data.referenceId is string && data.referenceId.size() <= 128 &&
             data.referenceNumber is string && data.referenceNumber.size() <= 100 &&
             data.description is string && data.description.size() <= 1000 &&
             data.debit is number && data.debit >= 0 &&
             data.credit is number && data.credit >= 0 &&
             data.createdAt is string;
    }

    // ENHANCED SETTINGS VALIDATION WITH ADMIN PROTECTION
    function isValidSettings(data) {
      return data.shopName is string && data.shopName.size() <= 200 &&
             data.phone is string && data.phone.size() <= 100 &&
             data.address is string && data.address.size() <= 500 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.footerMessage is string && data.footerMessage.size() <= 1000 &&
             (!("startingCash" in data) || data.startingCash is number) &&
             (!("startingBank" in data) || data.startingBank is number);
    }

    function isValidExpense(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.date is string &&
             data.category is string && (
               data.category == "Rent" ||
               data.category == "Electricity" ||
               data.category == "Salaries" ||
               data.category == "Transport" ||
               data.category == "Internet" ||
               data.category == "Office Expenses" ||
               data.category == "Maintenance" ||
               data.category == "Miscellaneous"
             ) &&
             data.description is string && data.description.size() <= 1000 &&
             data.amount is number && data.amount >= 0 &&
             data.paymentMethod is string && data.paymentMethod.size() <= 50 &&
             data.createdAt is string;
    }

    function isValidPartner(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.contact is string && data.contact.size() <= 100 &&
             data.investment is number && data.investment >= 0 &&
             data.ownershipPercentage is number && data.ownershipPercentage >= 0 && data.ownershipPercentage <= 100 &&
             data.joiningDate is string &&
             data.status is string && (data.status == "Active" || data.status == "Inactive") &&
             data.createdAt is string;
    }

    function isValidDrawing(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.partnerId is string && data.partnerId.size() <= 128 &&
             data.partnerName is string && data.partnerName.size() <= 200 &&
             data.date is string &&
             data.amount is number && data.amount >= 0 &&
             data.reason is string && data.reason.size() <= 500 &&
             data.createdAt is string;
    }

    // COUNTER VALIDATION - PREVENT MANUAL TAMPERING
    function isValidCounter(data) {
      return data.seq is number && data.seq >= 0;
    }

    function isCounterIncrement(data, existing) {
      // Allow only increments, never decrements or resets
      return data.seq is number && data.seq > existing.seq;
    }

    // ════════════════════════════════════════════════════════════════════════
    // COLLECTION SECURITY RULES (ROLE-BASED ACCESS CONTROL)
    // ════════════════════════════════════════════════════════════════════════

    // PARTS MASTER - READ: All authenticated, WRITE: Operators+, DELETE: Admin+
    match /parts/{partId} {
      allow read, list: if isOperator();
      allow create: if isOperator() && isValidId(partId) && isValidPart(incoming());
      allow update: if isOperator() && isValidId(partId) && isValidPart(incoming());
      allow delete: if isAdmin() && isValidId(partId);
    }

    // CUSTOMERS - READ: All authenticated, WRITE: Operators+, DELETE: Admin+
    match /customers/{customerId} {
      allow read, list: if isOperator();
      allow create: if isOperator() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isOperator() && isValidId(customerId) && isValidCustomer(incoming());
      allow delete: if isAdmin() && isValidId(customerId);
    }

    // SUPPLIERS - READ: All authenticated, WRITE: Operators+, DELETE: Admin+
    match /suppliers/{supplierId} {
      allow read, list: if isOperator();
      allow create: if isOperator() && isValidId(supplierId) && isValidSupplier(incoming());
      allow update: if isOperator() && isValidId(supplierId) && isValidSupplier(incoming());
      allow delete: if isAdmin() && isValidId(supplierId);
    }

    // SALES - READ: All authenticated, WRITE: Operators+, DELETE: Admin only
    match /sales/{saleId} {
      allow read, list: if isOperator();
      allow create: if isOperator() && isValidId(saleId) && isValidSale(incoming());
      allow update: if isAdmin() && isValidId(saleId) && isValidSale(incoming());
      allow delete: if isAdmin() && isValidId(saleId);
    }

    // PURCHASES - READ: All authenticated, WRITE: Operators+, DELETE: Admin only  
    match /purchases/{purchaseId} {
      allow read, list: if isOperator();
      allow create: if isOperator() && isValidId(purchaseId) && isValidPurchase(incoming());
      allow update: if isOperator() && isValidId(purchaseId) && isValidPurchase(incoming());
      allow delete: if isAdmin() && isValidId(purchaseId);
    }

    // ADJUSTMENTS - READ: All authenticated, WRITE: Operators+, DELETE: Admin only
    match /adjustments/{adjustmentId} {
      allow read, list: if isOperator();
      allow create: if isOperator() && isValidId(adjustmentId) && isValidAdjustment(incoming());
      allow update: if isAdmin() && isValidId(adjustmentId) && isValidAdjustment(incoming());
      allow delete: if isAdmin() && isValidId(adjustmentId);
    }

    // AUDIT LOGS - READ: All authenticated, WRITE: System only, DELETE: Never (immutable audit trail)
    match /audit_logs/{logId} {
      allow read, list: if isOperator();
      allow create: if isOperator() && isValidId(logId) && isValidAuditLog(incoming());
      allow update: if false; // Audit logs are immutable
      allow delete: if false; // Audit logs must never be deleted
    }

    // PAYMENTS - READ: All authenticated, WRITE: Operators+, DELETE: Admin only
    match /payments/{paymentId} {
      allow read, list: if isOperator();
      allow create: if isOperator() && isValidId(paymentId) && isValidPayment(incoming());
      allow update: if isOperator() && isValidId(paymentId) && isValidPayment(incoming());
      allow delete: if isAdmin() && isValidId(paymentId);
    }

    // LEDGER ENTRIES - READ: All authenticated, WRITE: System only, DELETE: Never (immutable financial records)
    match /ledger_entries/{entryId} {
      allow read, list: if isOperator();
      allow create: if isOperator() && isValidId(entryId) && isValidLedgerEntry(incoming());
      allow update: if false; // Ledger entries are immutable
      allow delete: if false; // Ledger entries must never be deleted
    }

    // SETTINGS - READ: All authenticated, WRITE: Admin+ only, DELETE: Never
    match /settings/{settingsId} {
      allow read: if isOperator();
      allow create, update: if isAdmin() && isValidId(settingsId) && isValidSettings(incoming());
      // SECURITY: Settings should never be deleted
      allow delete: if false;
    }

    // EXPENSES - READ: All authenticated, WRITE: Operators+, DELETE: Admin+
    match /expenses/{expenseId} {
      allow read, list: if isOperator();
      allow create: if isOperator() && isValidId(expenseId) && isValidExpense(incoming());
      allow update: if isOperator() && isValidId(expenseId) && isValidExpense(incoming());
      allow delete: if isAdmin() && isValidId(expenseId);
    }

    // PARTNERS - READ: All authenticated, WRITE/DELETE: Admin+ only (sensitive business data)
    match /partners/{partnerId} {
      allow read, list: if isOperator();
      allow create: if isAdmin() && isValidId(partnerId) && isValidPartner(incoming());
      allow update: if isAdmin() && isValidId(partnerId) && isValidPartner(incoming());
      allow delete: if isSuperAdmin() && isValidId(partnerId);
    }

    // DRAWINGS - READ: All authenticated, WRITE: Admin+, DELETE: Super Admin only
    match /drawings/{drawingId} {
      allow read, list: if isOperator();
      allow create: if isAdmin() && isValidId(drawingId) && isValidDrawing(incoming());
      allow update: if isAdmin() && isValidId(drawingId) && isValidDrawing(incoming());
      allow delete: if isSuperAdmin() && isValidId(drawingId);
    }

    // COUNTERS - READ: All authenticated, WRITE: System only, DELETE: Never (critical sequence numbers)
    match /counters/{counterName} {
      allow read, list: if isOperator();
      allow create: if isAdmin() && isValidId(counterName) && isValidCounter(incoming());
      allow update: if isAdmin() && isValidId(counterName) && isCounterIncrement(incoming(), existing());
      allow delete: if false; // Counters must never be deleted
    }
  }
}
